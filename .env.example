# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BUNNY_DATABASE_URL: libSQL URL for persistent Bunny Database (e.g. libsql://tenant-ezzymigo.lite.bunnydb.net)
BUNNY_DATABASE_URL=""

# BUNNY_DATABASE_TOKEN: Auth token for Bunny Database
BUNNY_DATABASE_TOKEN=""

# GOOGLE_CLIENT_SECRET: OAuth 2.0 Client Secret from Google Cloud Console
# Required for server-side authorization code exchange and refresh token rotation.
GOOGLE_CLIENT_SECRET=""

# CALENDAR_TOKEN_ENCRYPTION_KEY: Dedicated 32-byte secret string for encrypting OAuth refresh tokens at rest.
# Must be configured in environment secrets. Token storage is refused if absent.
CALENDAR_TOKEN_ENCRYPTION_KEY=""

# CLOUD_SCHEDULER_SECRET: Optional secret token to authenticate Google Cloud Scheduler invocations
CLOUD_SCHEDULER_SECRET=""
